# ----------------------------------------------------------------
# Configurare server Sanitas CAR — copiază în server/.env
# ----------------------------------------------------------------

PORT=3000

# SMTP-ul prin care se trimit cererile (ex: Gmail, Microsoft 365, cPanel)
SMTP_HOST=smtp.exemplu.ro
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=cereri@sanitascar.ro
SMTP_PASS=parola-de-aplicatie

# Expeditorul afișat în e-mail
MAIL_FROM="Sanitas CAR <cereri@sanitascar.ro>"

# Inbox-ul administrativ care primește toate cererile
CAR_INBOX=secretariat@sanitascar.ro

# Setează pe 1 ca să testezi fluxul fără SMTP configurat
# (cererile se salvează în server/cereri/ și nu se trimit e-mailuri)
DRY_RUN=0
